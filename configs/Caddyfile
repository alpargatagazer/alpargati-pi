## Global options
{
    # Disable HTTPS auto-redirect for local development
    auto_https off
}

# Snippet for internal access restriction (Local LAN + Tailscale)
(internal_only) {
    @not_internal not remote_ip 192.168.0.0/16 172.16.0.0/12 10.0.0.0/8 127.0.0.1/8 ::1 100.64.0.0/10
    respond @not_internal "Access denied" 403
}

# Main homepage
http://{{DOMAIN}}, http://home.{{DOMAIN}}, http://pi.home, https://{{TS_DOMAIN}} {
    import internal_only
    tls internal
    reverse_proxy homepage:3000
}

# Vaultwarden - Password Manager (protected by its own auth + Caddy basic auth)
# Uses internal HTTPS to satisfy "Subtle Crypto" requirements
https://vault.{{DOMAIN}}, https://vault.{{TS_DOMAIN}} {
    import internal_only
    tls internal
    basicauth {
        {{CADDY_AUTH_USER}} {{CADDY_AUTH_PASSWORD_HASH}}
    }
    reverse_proxy vaultwarden:80
}

# AdGuard Home - DNS Admin Panel
http://adguard.{{DOMAIN}}, https://adguard.{{TS_DOMAIN}} {
    import internal_only
    tls internal
    reverse_proxy host.docker.internal:3000
}

# FileBrowser - File Manager (protected by its own auth + Caddy basic auth)
http://files.{{DOMAIN}}, https://files.{{TS_DOMAIN}} {
    import internal_only
    tls internal
    reverse_proxy filebrowser:8080
}

# Dozzle - Docker Log Viewer (protected by Caddy basic auth)
http://logs.{{DOMAIN}}, https://logs.{{TS_DOMAIN}} {
    import internal_only
    tls internal
    basicauth {
        {{CADDY_AUTH_USER}} {{CADDY_AUTH_PASSWORD_HASH}}
    }
    reverse_proxy dozzle:8080
}

