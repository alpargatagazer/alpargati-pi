# Timezone
TZ=Europe/Madrid

# General configuration
DOMAIN=pi.home
VOLUMES_PATH=/opt/alpargati-pi/volumes
DATA_PATH=/opt/alpargati-pi/data

# Tailscale (Optional but recommended)
TS_AUTHKEY=tskey-auth-yourkeyhere
TS_API_KEY=tskey-api-...
TS_DOMAIN=your-tailnet-name.ts.net

# Caddy Basic Auth (protects Dozzle and other services)
CADDY_AUTH_USER="your_username"
CADDY_AUTH_PASSWORD="your_secure_password"

# Vaultwarden configuration
# Generate with: openssl rand -base64 48
VAULTWARDEN_ADMIN_TOKEN="generate_a_secure_token_here"

# AdGuard Home has its own web-based setup wizard on first run
# No credentials needed here - set them during initial setup

# Syncthing configuration
SYNCTHING_GUI_USER="admin"
SYNCTHING_GUI_PASSWORD="change_this_password"

# WUD configuration (container update manager)
WUD_ADMIN_USER="admin"
WUD_ADMIN_PASSWORD="change_this_password"
